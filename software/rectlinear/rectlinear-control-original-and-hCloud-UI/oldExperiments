void servoMotionXYZ()
{
	hServoModule.s1.calibrate(-90, 2400, 90, 800);
	hServoModule.s2.calibrate(-90, 800, 90, 2400);
	hServoModule.s3.calibrate(-90, 800, 90, 2400);
	hServoModule.s4.calibrate(-90, 800, 90, 2400);
	hServoModule.s5.calibrate(-90, 800, 90, 2400);

	while (1) {
		sys.delay(100);

		tetar = teta * M_PI / 180;
		float r = x - 150.0 * cosf(tetar);
		float h = y - 150.0 * sinf(tetar);

		float d1 = sqrt(pow(h, 2) + pow(r, 2));
		float betar = acosf((45000.0 - pow(d1, 2)) / (45000.0));
		beta = betar;

		float alfar = atanf(h / r) + acosf(d1 / 300.0);
		alfa = (180 * (alfar - (M_PI / 2))) / M_PI; //kat na serwie nr 1 -> prod, tyl

		float d2 = sqrt(27541.0 + 21300.0 * cosf(betar));

		float gammar = acosf((17459.0 + pow(d2, 2)) / (300.0 * d2)) + acosf((pow(d2, 2) - 18779) / (122 * d2)) + alfar - (M_PI / 2);
		gamma1 = (180.0 * (gammar)) / M_PI;  // kat na serwie 2

		float A = sqrt(25000.0 - 15000.0 * cosf(0.428 + alfar - tetar));
		float  kat1 = acosf((20000.0 + pow(A, 2)) / (300.0 * A));
		float kat2 = M_PI - alfar - kat1;
		float B = sqrt(pow(27, 2) + pow(A, 2) - 2 * 27 * A * cosf(kat2));
		float kat3 = acosf((pow(B, 2) + pow(27, 2) - pow(A, 2)) / (54 * B));
		float kat4 = acosf((-18779.0 + pow(B, 2)) / (122.0 * B));

		delta = (M_PI - kat3 - kat4) * 180.0 / M_PI; // kat na serwie 3


		if (1) {
			sys.delay(1000);
			platform.ui.console("cl2").printf("d1 wynosi =  %f \n", d1);
			platform.ui.console("cl2").printf("d2 wynosi =  %f \n", d2);
			platform.ui.console("cl4").printf("alfa wynosi =  %f \n", alfa);
			platform.ui.console("cl4").printf("gamma1 wynosi =  %f \n", gamma1);
			platform.ui.console("cl4").printf("delta wynosi =  %f \n", delta);
			platform.ui.console("cl1").printf("kat1 wynosi =  %f \n", kat1);
			platform.ui.console("cl1").printf("A wynosi =  %f \n", A);

		}



	}


}

